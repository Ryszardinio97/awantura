# Skopiuj ten plik jako ".env" i uzupełnij.
# Dane znajdziesz w https://discord.com/developers/applications -> Twoja aplikacja -> OAuth2

# Client ID (to samo co Application ID)
VITE_DISCORD_CLIENT_ID=
# Client Secret – NIGDY nie pokazuj go nikomu i nie wrzucaj na GitHuba
DISCORD_CLIENT_SECRET=

# ID użytkowników Discorda, którzy zawsze mogą przejąć prowadzenie (po przecinku).
# ID skopiujesz: Ustawienia -> Zaawansowane -> Tryb dewelopera, potem PPM na siebie -> Kopiuj ID.
HOST_IDS=

# 1 = można wejść w zwykłej przeglądarce (http://localhost:5173) wpisując nick – do testów.
# Na "produkcji" ustaw 0, żeby nikt nie podszył się pod gracza.
DEV_LOGIN=1

PORT=3001

# ---------- Tryb głosowy: bot przenoszący drużyny na ich kanały ----------
# Developer Portal -> Bot -> Reset Token. Tak samo tajny jak sekret!
DISCORD_BOT_TOKEN=
# ID serwera Discorda (PPM na ikonę serwera -> Kopiuj ID serwera)
GUILD_ID=
# ID kanałów głosowych (PPM na kanał -> Kopiuj ID kanału)
VOICE_MAIN=
VOICE_BLUE=
VOICE_GREEN=
VOICE_YELLOW=
# opcjonalnie: kanał głosowy Mistrzów (narada w finale)
VOICE_CHAMPS=
